# ========== PostgreSQL ==========
POSTGRES_PASSWORD=your_strong_password_here

# ========== JWT ==========
# Generate with: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_at_least_32_chars_long_here

# ========== MinIO ==========
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your_minio_secret_password

# ========== Stripe ==========
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Get from https://dashboard.stripe.com/webhooks after creating webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# ========== Frontend ==========
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_HLS_BASE_URL=http://localhost:8090/hls

# ========== Admin seed (first run) ==========
ADMIN_EMAIL=admin@classroom.com
ADMIN_PASSWORD=Admin@123456
